<?xml version="1.0" encoding="UTF-8"?>
<!-- XML schema for ISIS 2D control file, copyright Jacobs 2023 -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="https://www.floodmodeller.com" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="https://www.floodmodeller.com" elementFormDefault="qualified">
	<xs:element name="ISIS2Dproject">
		<xs:complexType>
			<xs:sequence>
                <xs:element name="metadata" type="metadataType" minOccurs="0" maxOccurs="1"/>              
				<xs:element name="link1d" type="link1dType" minOccurs="0" maxOccurs="2"/>
				<xs:element name="logfile" type="xs:string" minOccurs="0"/>
				<xs:element name="resultsfolder" type="resultsfolderType" minOccurs="0" maxOccurs="1"/>
				<xs:element name="domain" type="domainType" maxOccurs="unbounded"/>
				<xs:element name="restart_options" type="restart_optionsType" minOccurs="0"/>
				<xs:element name="advanced_options" type="advanced_optionsType" minOccurs="0"/>
				<xs:element name="roughness_codes" type="roughnessCodeListType" minOccurs="0" maxOccurs="1"/>
				<xs:element name="processor" type="processorType" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
			<xs:attribute name="name" type="xs:string" use="required"/>
			<xs:attribute name="unit_system" type="unit_systemType" use="optional"/>
			<xs:attribute name="description" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="onoffType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="on"/>
			<xs:enumeration value="off"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="list_string_type">
		<xs:list itemType="xs:string"/>
	</xs:simpleType>
	<xs:simpleType name="fileTypeAttrEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="shp"/>
			<xs:enumeration value="asc"/>
			<xs:enumeration value="tif"/>
			<xs:enumeration value="flt"/>
			<xs:enumeration value="csv"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="topoTypeAttrEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="standard"/>
			<xs:enumeration value="zline"/>
			<xs:enumeration value="zsurface"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="roughnessTypeAttrEnum">
		<xs:restriction base="xs:string">
			<xs:enumeration value="grid"/>
			<xs:enumeration value="floatGrid"/>
			<xs:enumeration value="masterMap"/>
			<xs:enumeration value="polygon"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name = "fileType">
		<xs:simpleContent>
			<xs:extension base="xs:string">
				<xs:attribute name ="type" type ="fileTypeAttrEnum" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name ="fileTypeListType">
		<xs:sequence>
			<xs:element name = "fmfile" type = "fileType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name = "topoType">
		<xs:sequence>
			<xs:element name = "filelist" type ="fileTypeListType"/>
			<xs:element name = "resampling" type ="resamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name = "adaptive_mesh_refinement" type="adaptiveMeshRefinementType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="type" type="topoTypeAttrEnum" use="optional"/>
		<xs:attribute name="description" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name = "roughnessCoefficientType">
		<xs:sequence>
			<xs:element name = "filelist" type ="fileTypeListType"/>
			<xs:element name = "resampling" type ="resamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name = "adaptive_mesh_refinement" type="adaptiveMeshRefinementType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="law" type="roughness_law" use="required"/>
		<xs:attribute name="type" type="roughness_distribution_type" use="required"/>
		<xs:attribute name="default_roughness" type="xs:double" use="optional"/>
		<xs:attribute name="assign_value" type="xs:double" use="optional"/>
		<xs:attribute name="field_name" type="xs:string" use="optional"/>
		<xs:attribute name="lookuptable" type="xs:string" use="optional"/>
		<xs:attribute name="description" type="xs:string" use="optional"/>
	</xs:complexType>
	<xs:complexType name="meshRefinementType">
		<xs:sequence>
			<xs:element name = "filelist" type ="fileTypeListType"/>
		</xs:sequence>
		<xs:attribute name="source" type="meshRefinementSourceType" use="required"/>
	</xs:complexType>
	<xs:simpleType name="ValueCheckType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="on"/>
			<xs:enumeration value="off"/>
			<xs:enumeration value="true"/>
			<xs:enumeration value="false"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="checkType">
		<xs:simpleContent>
			<xs:extension base="ValueCheckType">
				<xs:attribute name="format" default="ASCII">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="GEOTIFF"/>
							<xs:enumeration value="ASCII"/>
							<xs:enumeration value="SHAPEFILE"/>
							<xs:enumeration value="GEOPACKAGE"/>
							<xs:enumeration value="GEOPARQUET"/>
							<xs:enumeration value="FLATGEOBUF"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="run_scheme">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ADI"/>
			<xs:enumeration value="TVD"/>
			<xs:enumeration value="FAST"/>
			<xs:enumeration value="FAST Dynamic"/>
			<xs:enumeration value="Godunov"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="wet_boundaryType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="warning"/>
			<xs:enumeration value="error"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="double_precisionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="advised"/>
			<xs:enumeration value="required"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="lossType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="CN">
				<xs:annotation>
					<xs:documentation>SCS curve number loss </xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="GA">
				<xs:annotation>
					<xs:documentation>Green-Ampt infiltration</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<!-- SCS curve number loss -->
			<!-- Green-Ampt infiltration loss loss -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="roughness_law">
		<xs:restriction base="xs:string">
			<xs:enumeration value="manning"/>
			<xs:enumeration value="chezy"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="unit_systemType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SI"/>
			<xs:enumeration value="US"/>
			<xs:enumeration value="American"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="roughness_distribution_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="global"/>
			<xs:enumeration value="globalmultiplier"/>
			<xs:enumeration value="file"/>
			<xs:enumeration value="mastermap"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="roughnessCodeItemType">
		<xs:simpleContent>
			<xs:extension base="xs:double">
				<xs:attribute name="ID" type="xs:string" use="required"/>
				<xs:attribute name="description" type="xs:string" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="roughnessCodeListType">
		<xs:sequence>
			<xs:element name="item" type="roughnessCodeItemType" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="law" type="roughness_law" use="optional"/>
	</xs:complexType>
	<xs:simpleType name="adjustz_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="upwards"/>
			<xs:enumeration value="downwards"/>
			<xs:enumeration value="both"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="initial_condition_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="globalwaterlevel"/>
			<xs:enumeration value="globaldepth"/>
			<xs:enumeration value="elevationfile"/>
			<xs:enumeration value="depthfile"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="time_units">
		<xs:restriction base="xs:string">
			<xs:enumeration value="day"/>
			<xs:enumeration value="hour"/>
			<xs:enumeration value="minute"/>
			<xs:enumeration value="second"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="sediment_diameter_units">
		<xs:restriction base="xs:string">
			<xs:enumeration value="m"/>
			<xs:enumeration value="mm"/>
			<xs:enumeration value="ft"/>
			<xs:enumeration value="in"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="sediment_density_units">
		<xs:restriction base="xs:string">
			<xs:enumeration value="kg/m3"/>
			<xs:enumeration value="g/cm3"/>
			<xs:enumeration value="slugs/ft3"/>
			<xs:enumeration value="lbm/ft3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="rainfall_units">
		<xs:restriction base="xs:string">
			<xs:enumeration value="mm/hr"/>
			<xs:enumeration value="mm/h"/>
			<xs:enumeration value="m/s"/>
			<xs:enumeration value="in/hr"/>
			<xs:enumeration value="mm"/>
			<xs:enumeration value="in"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="boundary_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="waterelevation"/>
			<xs:enumeration value="qhbdy"/>
			<xs:enumeration value="totalflow"/>
			<xs:enumeration value="flowperunitwidth"/>
			<xs:enumeration value="verticalflow"/>
			<xs:enumeration value="verticalflowperunitwidth"/>
			<xs:enumeration value="elevation"/>
			<xs:enumeration value="depth"/>
			<xs:enumeration value="weir"/>
			<xs:enumeration value="outflow"/>
			<xs:enumeration value="velocitydepth"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="output_format">
		<xs:restriction base="xs:string">
			<xs:enumeration value="SMS9"/>
			<xs:enumeration value="CSV"/>
			<xs:enumeration value="XMDF"/>
			<xs:enumeration value="NETCDF"/>
			<xs:enumeration value="ASCII"/>
			<xs:enumeration value="GEOTIFF"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="output_variable">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Flow"/>
			<xs:enumeration value="Elevation"/>
			<xs:enumeration value="Velocity"/>
			<xs:enumeration value="Depth"/>
			<xs:enumeration value="Froude"/>
			<xs:enumeration value="Hazard"/>
			<xs:enumeration value="Bedelevation"/>
			<xs:enumeration value="HazardClass"/>
			<xs:enumeration value="NegativeDepth"/>
			<xs:enumeration value="BedShearStress"/>
			<xs:enumeration value="ExcessShearStress"/>
			<xs:enumeration value="ShieldsParameter"/>
			<xs:enumeration value="StreamCompetence"/>
			<xs:enumeration value="InfiltrationLoss"/>
			<xs:enumeration value="InfiltrationRate"/>
			<xs:enumeration value="RelativeMassError"/>
			<xs:enumeration value="RoughnessCoefficient"/>
			<xs:enumeration value="Courant"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="output_variables">
		<xs:list itemType="output_variable"/>
	</xs:simpleType>
	<xs:simpleType name="boundary_value_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="timevar"/>
			<xs:enumeration value="fixedvalue"/>
			<xs:enumeration value="ied"/>
			<xs:enumeration value="csv"/>
			<xs:enumeration value="hydrologyunit"/>
			<xs:enumeration value="hpcsv"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="hydrology_value_type">
		<xs:restriction base="xs:string">
			<xs:enumeration value="timevar"/>
			<xs:enumeration value="csv"/>
			<xs:enumeration value="hydrologyunit"/>
			<xs:enumeration value="hydrologyunitgross"/>
			<xs:enumeration value="refh2csv"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="riemannSolverType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="CenU"/> <!-- 1 Central-upwind solver of Kurganov and Petrova (2001) -->
			<xs:enumeration value="HLL"/> <!-- 2 Standard HLL solver of Harten, Lax and van Leer (1983) -->
			<xs:enumeration value="Roe"/> <!-- 3 Standard Roe solver -->
			<xs:enumeration value="HLLE"/> <!-- 4 The HLLE (Harten-Lax-van Leer-Einfeldt) solver of Harten, Lax and van Leer (1983), and Einfeldt (1988) -->
			<xs:enumeration value="Roe_C"/> <!-- 5 (default) Cartesian version of the Roe solver -->
			<xs:enumeration value="HLL_C"/> <!-- 6 Toro's adaptation of the HLLC (Harten-Lax-van Leer-Contact) solver of Toro Spruce and Speares (1994) -->
			<xs:enumeration value="CenUT"/> <!-- 7 Toro's adaptation of the central-upwind solver of Kurganov and Petrova (2001) -->
			<xs:enumeration value="CenUT_C"/> <!-- 8 Cartsesian version of RiemannCENUT -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="reconstructionMethodType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="VFR1"/> <!-- 0 VFR method for standard SWE (default) -->
			<xs:enumeration value="VFR2"/> <!-- 1 VFR method for porous SWE -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="meshRefinementSourceType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="point"/>
			<xs:enumeration value="line"/>
			<xs:enumeration value="polygon"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="resamplingMethodType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Direct"/>
			<xs:enumeration value="FillIn"/>
			<xs:enumeration value="InverseDistanceToAPower"/>
			<xs:enumeration value="MovingAverage"/>
			<xs:enumeration value="MetricMinimum"/>
			<xs:enumeration value="MetricMaximum"/>
			<xs:enumeration value="Linear"/>
			<xs:enumeration value="InverseDistanceToAPowerNearestNeighbor"/>
			<xs:enumeration value="NearestNeighbor"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="GeneralResamplingOptionsType">
		<xs:sequence>
			<xs:element name="exponent" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="smoothing" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="anisotropyRatio" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="anisotropyAngle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="xRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="yRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="radius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="maxPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="minPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InverseDistanceResamplingOptionsType">
		<xs:sequence>
			<xs:element name="exponent" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="smoothing" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="anisotropyRatio" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="anisotropyAngle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="xRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="yRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="maxPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="minPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MovingAverageResamplingOptionsType">
		<xs:sequence>
			<xs:element name="xRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="yRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="maxPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="minPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NearestNeighborResamplingOptionsType">
		<xs:sequence>
			<xs:element name="xRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="yRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="MetricResamplingOptionsType">
		<xs:sequence>
			<xs:element name="xRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="yRadius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="minPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="LinearResamplingOptionsType">
		<xs:sequence>
			<xs:element name="angle" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="InvDistNearNeighResamplingOptionsType">
		<xs:sequence>
			<xs:element name="exponent" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="smoothing" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="radius" type="xs:double" minOccurs="0" maxOccurs="1"/>
			<xs:element name="maxPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="minPoints" type="xs:integer" minOccurs="0" maxOccurs="1"/>
			<xs:element name="nodata" type="xs:double" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="resamplingOptionsType">
		<xs:sequence>
			<xs:element name="GeneralResamplingOptions" type="GeneralResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InverseDistanceResamplingOptions" type="InverseDistanceResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MovingAverageResamplingOptions" type="MovingAverageResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="NearestNeighborResamplingOptions" type="NearestNeighborResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="MetricResamplingOptions" type="MetricResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="LinearResamplingOptions" type="LinearResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
			<xs:element name="InvDistNearNeighResamplingOptions" type="InvDistNearNeighResamplingOptionsType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
		<xs:attribute name="method" type="resamplingMethodType" use="required"/>
	</xs:complexType>
    <xs:simpleType name="spatial_diagnostics_format_type">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CSV"/>
            <xs:enumeration value="GEOJSON"/>
            <xs:enumeration value="FLATGEOBUF"/>
        </xs:restriction>
    </xs:simpleType>
	<xs:complexType name="projectionType">
    <xs:simpleContent>
        <xs:extension base="xs:string">
            <xs:attribute name="type" use="required">
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:enumeration value="EPSG"/>
                        <xs:enumeration value="FILE"/>
                    </xs:restriction>
                </xs:simpleType>
            </xs:attribute>
        </xs:extension>
    </xs:simpleContent>
	</xs:complexType>
	<xs:simpleType name="gravitytermType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="GroundSlopeFlux"/>
			<xs:enumeration value="WellBalancedGroundSlopeFlux"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="rewind_settingsType">
		<xs:simpleContent>
			<xs:extension base="xs:integer">
				<xs:attribute name="backup_period" type="xs:double" use="optional"/>
				<xs:attribute name="max_mass_error" type="xs:double" use="optional"/>
				<xs:attribute name="max_cfl" type="xs:double" use="optional"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	<xs:complexType name="computational_areaType">
		<xs:sequence>
			<xs:element name="xll" type="xs:double"/>
			<xs:element name="yll" type="xs:double"/>
			<xs:element name="dx" type="xs:double"/>
			<xs:element name="nrows" type="xs:integer"/>
			<xs:element name="ncols" type="xs:integer"/>
			<xs:element name="active_area" type="xs:string" minOccurs="0"/>
			<xs:element name="deactive_area" type="xs:string" minOccurs="0"/>
			<xs:element name="rotation" type="xs:double" minOccurs="0"/>
			<xs:element name="projection" type="projectionType" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="timeType">
		<xs:sequence>
			<xs:element name="start_time" type="xs:time" minOccurs="0"/>
			<xs:element name="start_date" type="xs:string" minOccurs="0"/>
			<xs:element name="timezero_datetime" minOccurs="0">
				<xs:complexType>
					<xs:simpleContent>
						<xs:extension base="xs:string">
